{
  "name": "@micshare/client",
  "productName": "Mic Share",
  "version": "0.2.2",
  "private": true,
  "description": "Mic Share desktop client: Electron + React + Vite + Tailwind CSS.",
  "author": "Mic Share",
  "main": "src/main/index.js",
  "type": "commonjs",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "vite build",
    "start": "electron .",
    "pack": "npm run build && electron-builder --dir",
    "dist": "npm run build && electron-builder --win nsis",
    "dist:publish": "npm run build && electron-builder --win nsis --publish always",
    "lint": "echo \"client: no lint configured yet\""
  },
  "dependencies": {
    "electron-log": "^5.2.4",
    "electron-store": "^8.2.0",
    "electron-updater": "^6.6.2"
  },
  "devDependencies": {
    "@micshare/shared": "*",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "axios": "^1.7.9",
    "electron": "43.3.0",
    "electron-builder": "^26.0.12",
    "postcss": "^8.4.49",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "socket.io-client": "^4.8.3",
    "tailwindcss": "^3.4.17",
    "vite": "^6.0.7"
  }
}
